# Database
GW_DATABASE_URL=postgresql+asyncpg://groundwork:groundwork@localhost:5432/groundwork
GW_DB_POOL_SIZE=20
GW_DB_MAX_OVERFLOW=10
GW_DB_POOL_RECYCLE=1800

# OIDC (any OIDC-compliant provider)
GW_OIDC_ISSUER_URL=https://your-idp.example.com
GW_OIDC_CLIENT_ID=your-client-id
GW_OIDC_CLIENT_SECRET=your-client-secret
GW_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# AWS
GW_AWS_REGION=us-east-1
GW_AWS_GROUNDWORK_ACCOUNT_ID=444455556666
GW_AWS_ORG_ROOT_ID=r-xxxx
GW_ADMIN_ROLE_NAME=GroundworkAdmin-DO-NOT-DELETE

# App
GW_APP_NAME=Groundwork
GW_APP_URL=http://localhost:8000
GW_SESSION_SECRET=change-me-to-a-random-string
GW_DEBUG=true
